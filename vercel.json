{
    "version": 2,
    "functions": {
        "api/generate.py": {
            "maxDuration": 60,
            "memory": 1024,
            "includeFiles": "templates/**"
        }
    },
    "rewrites": [
        {
            "source": "/scott-deck-builder/api/:path*",
            "destination": "/api/generate"
        },
        {
            "source": "/scott-deck-builder/:path*",
            "destination": "/:path*"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/generate.py"
        },
        {
            "source": "/api/generate",
            "destination": "/api/generate.py"
        },
        {
            "source": "/css/:asset*",
            "destination": "/public/css/:asset*"
        },
        {
            "source": "/js/:asset*",
            "destination": "/public/js/:asset*"
        },
        {
            "source": "/",
            "destination": "/public/index.html"
        },
        {
            "source": "/index.html",
            "destination": "/public/index.html"
        }
    ],
    "cleanUrls": true
}
