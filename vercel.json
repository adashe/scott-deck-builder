{
    "version": 2,
    "functions": {
        "api/generate.py": {
            "maxDuration": 60,
            "includeFiles": "templates/**",
            "memory": 1024
        },
        "api/index.py": {
            "includeFiles": "templates/**"
        }
    },
    "rewrites": [
        {
            "source": "/css/:asset*",
            "destination": "/css/:asset*"
        },
        {
            "source": "/js/:asset*",
            "destination": "/js/:asset*"
        },
        {
            "source": "/scott-deck-builder/api/:path*",
            "destination": "/api/generate"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/generate"
        },
        {
            "src": "/api/generate",
            "dest": "/api/generate.py"
        },
        {
            "source": "/scott-deck-builder/",
            "destination": "/api/index"
        },
        {
            "source": "/scott-deck-builder",
            "destination": "/api/index"
        },
        {
            "source": "/",
            "destination": "/api/index"
        },
        {
            "source": "/scott-deck-builder/:path*",
            "destination": "/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ],
    "cleanUrls": true
}
